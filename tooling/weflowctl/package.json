{
  "name": "weflowctl",
  "version": "0.1.0",
  "description": "Weflow development CLI (dev up / doctor / down + config).",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "weflowctl": "./dist/tooling/weflowctl/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/tooling/weflowctl/src/cli.js",
    "test": "node ../../core/node_modules/tsx/dist/cli.mjs --test test/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
