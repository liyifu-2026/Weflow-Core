{
  "name": "weflowctl",
  "version": "0.1.0",
  "description": "Weflow command line tool for Solution Pack validation, planning and installation commands.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "weflowctl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@weflow/solution-sdk": "link:../../packages/solution-sdk"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
