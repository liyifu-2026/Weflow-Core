# Weflow 生产环境配置模板（Windows 服务器）
#
# 用法：
#   1. 复制本文件为 core/.env（部署目录下的 core/.env）
#   2. 逐项填写占位值（<...> 标记的部分必须修改）
#   3. 修改后重启服务生效：weflowctl service restart（或单进程重启）
#
# 注意：
#   - 本文件包含密钥，权限应收紧；不要提交进 git（.gitignore 已排除 .env*）
#   - 密钥类配置也可用 <NAME>_FILE 形式注入（值指向只读文件路径）
#   - Windows 路径用反斜杠或正斜杠均可；含空格的路径建议加双引号

# ============ 运行环境 ============
NODE_ENV=production
LOG_LEVEL=info
# 服务监听地址：0.0.0.0 = 对局域网开放；仅本机访问用 127.0.0.1
HEALTH_HOST=0.0.0.0

# ============ 端口 ============
CORE_PORT=3100
AGENT_WORKER_HEALTH_PORT=3101
AGENT_WORKER_CONCURRENCY=3
MEMORY_CAPTURE_CONCURRENCY=1
MEDIA_PROCESSING_CONCURRENCY=1
INGESTION_WORKER_HEALTH_PORT=3102

# ============ 数据库 / 缓存 ============
# 同机 PostgreSQL 16 / Redis 7；改密码后同步此处
DATABASE_URL=postgresql://<用户>:<密码>@127.0.0.1:5432/weflow
REDIS_URL=redis://127.0.0.1:6379

# ============ 文件存储 ============
# 媒体/头像/素材根目录；必须是持久盘上的绝对路径，定期备份
FILE_STORAGE_ROOT=C:\weflow\data\files

# ============ 前端静态托管（R4 起由 api 进程托管，不再需要 Vite）============
# 指向 support-web 构建产物目录（含 index.html）；热更新 = 整包替换该目录
WEB_DIST_DIR=C:\weflow\sites\support-web\dist

# ============ 会话 ============
# 局域网 HTTP 部署必须为 false（否则浏览器不回传 Cookie 无法登录）；
# 走 HTTPS（含反向代理终结 TLS）时保持 true
SESSION_COOKIE_SECURE=false
# 跨子域共享会话时才需要（如 api.example.com 与 web.example.com）：
# SESSION_COOKIE_DOMAIN=example.com

# ============ 通道（微信 Channel Host，与微信同机）============
CHANNEL_HOST_BASE_URL=http://127.0.0.1:43123
CHANNEL_HOST_TOKEN=<部署时生成的随机token>
CHANNEL_HOST_POLL_INTERVAL_MS=1000

# ============ 模型 ============
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=<模型API密钥>
MODEL_NAME=deepseek-v4-flash
MODEL_TIMEOUT_MS=60000

# ============ 视觉 / 语音 ============
VISION_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
VISION_API_KEY=<视觉API密钥>
VISION_MODEL=mimo-v2.5
VISION_TIMEOUT_MS=60000
ASR_MODEL=mimo-v2.5

# ============ 预判分流 / 直答（可选，不配则对应功能关闭）============
TRIAGE_BASE_URL=https://api.siliconflow.cn/v1
TRIAGE_MODEL=Qwen/Qwen2.5-7B-Instruct
TRIAGE_API_KEY=<分流模型密钥>
FAST_BASE_URL=https://api.siliconflow.cn/v1
FAST_MODEL=THUDM/GLM-4-9B-0414
FAST_API_KEY=<直答模型密钥>

# ============ 知识库（WeKnora）============
WEKNORA_BASE_URL=http://127.0.0.1/api/v1
WEKNORA_API_KEY=<WeKnora密钥>
WEKNORA_TIMEOUT_MS=15000
# WEKNORA_KNOWLEDGE_BASE_IDS=kb-a,kb-b

# ============ 跨域 ============
# 前端由 api 同源托管时通常无需配置；独立域名访问前端时填其 origin（逗号分隔）
# CORS_ORIGINS=https://web.example.com

# ============ 业务插件目录直读 ============
# 指向业务仓库 customer-support 目录；插件 dist 更新后重启 worker 生效
WEFLOW_PLUGIN_DIR=C:\weflow\weflow-solutions\solutions\customer-support

# ============ WeKnora 桥接（可选）============
# KNORA_ACCOUNT_ENC_KEY=<至少32位十六进制>
# KNORA_TENANT_ID=10000
# KNORA_ACCOUNT_EMAIL_DOMAIN=weflow.com
