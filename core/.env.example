# Weflow Core 本地开发环境变量模板
#
# 与 infrastructure/config/config.ts 的 environmentSchema 一一对应（2026-09-20 重生成）。
# 标注【必填】的键无默认值，缺失时启动失败；其余键有 schema 默认值，可按需覆盖。
# 密钥注入二选一：本地开发直接填明文键（下面的 KEY=），生产用 *_FILE 指向只读文件。
# 注意 *_FILE 优先级更高且不做存在性检查——设了但文件不存在会直接启动失败。

# ── 进程与端口 ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
HEALTH_HOST=127.0.0.1
CORE_PORT=3100
AGENT_WORKER_HEALTH_PORT=3101
INGESTION_WORKER_HEALTH_PORT=3102
# 工人并发（1-20）：Agent 全局并发 / 记忆捕获 / 媒体处理（默认 1 避免多模态过载）
AGENT_WORKER_CONCURRENCY=3
MEMORY_CAPTURE_CONCURRENCY=1
MEDIA_PROCESSING_CONCURRENCY=1

# ── 存储【必填】──────────────────────────────────────────────
DATABASE_URL=postgresql://weflow:weflow@127.0.0.1:5432/weflow
REDIS_URL=redis://127.0.0.1:6379
FILE_STORAGE_ROOT=.data/files

# ── Channel Host（通道入口；不配置 = 纯平台模式）─────────────
# Python Channel Host：只提供 durable inbound text observations
# CHANNEL_HOST_BASE_URL=http://127.0.0.1:43123
# CHANNEL_HOST_TOKEN=dev-channel-host-token
# CHANNEL_HOST_TOKEN_FILE=/run/secrets/channel_host_token
CHANNEL_HOST_POLL_INTERVAL_MS=500

# ── 主决策模型【必填】────────────────────────────────────────
# DeepSeek/OpenAI-compatible Model Runtime；密钥优先通过只读文件注入
MODEL_BASE_URL=https://api.deepseek.com
# MODEL_API_KEY=sk-xxx
# MODEL_API_KEY_FILE=/run/secrets/model_api_key
MODEL_NAME=deepseek-v4-flash
MODEL_TIMEOUT_MS=60000
MODEL_MAX_TOKENS=16384
MODEL_DECISION_TIMEOUT_MS=180000

# ── 视觉模型（图片描述；MiMo/OpenAI 兼容端点）────────────────
VISION_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# VISION_API_KEY=xxx
# VISION_API_KEY_FILE=/run/secrets/vision_api_key
VISION_MODEL=mimo-v2.5
VISION_TIMEOUT_MS=60000

# ── 语音转写（默认复用视觉端点与密钥；端点不支持音频时覆盖为 mimo-v2.5-asr）──
ASR_MODEL=mimo-v2.5
# ASR_BASE_URL=https://api.siliconflow.cn/v1
# ASR_API_KEY=xxx
ASR_TIMEOUT_MS=60000

# ── 预判分流模型（极速小模型：人工/自动、简单/标准分流）──────
TRIAGE_BASE_URL=https://api.siliconflow.cn/v1
TRIAGE_MODEL=Qwen/Qwen2.5-7B-Instruct
# TRIAGE_API_KEY=xxx
TRIAGE_TIMEOUT_MS=3000

# ── 直答模型（分流判定 simple 且运营开启直答时生成回复）──────
FAST_BASE_URL=https://api.siliconflow.cn/v1
FAST_MODEL=THUDM/GLM-4-9B-0414
# FAST_API_KEY=xxx
FAST_TIMEOUT_MS=15000

# ── WeKnora 知识库（外部 Provider）───────────────────────────
# WeKnora 仅作为知识解析与检索服务；Core 不调用其 Agent、Chat 或 IM API。
# 默认自动发现该 API Key 可访问的知识库；如需收窄范围，可设置逗号分隔的 KB ID 白名单。
WEKNORA_BASE_URL=http://localhost/api/v1
# WEKNORA_API_KEY=xxx
# WEKNORA_API_KEY_FILE=/run/secrets/weknora_api_key
WEKNORA_TIMEOUT_MS=15000
# WEKNORA_KNOWLEDGE_BASE_IDS=kb-a,kb-b
# WeKnora 站点 origin（不带 /api/v1）；不配置回退 WEKNORA_BASE_URL 去后缀
# WEKNORA_ORIGIN=https://kb.example.com

# ── WeKnora 桥接（代管登录；ENC_KEY 缺失时桥接路由返回 503）──
# KNORA_ACCOUNT_ENC_KEY=至少8字符的加密密钥
KNORA_TENANT_ID=10000
KNORA_ACCOUNT_EMAIL_DOMAIN=weflow.com

# ── 头像代理 ─────────────────────────────────────────────────
AVATAR_PROXY_TIMEOUT_MS=5000
AVATAR_CACHE_TTL_MS=3600000
# 允许拉取的域名后缀白名单（逗号分隔；不配置 = 头像代理一律 404）
# AVATAR_ALLOWED_HOSTS=qlogo.cn,weixin.qq.com

# ── 安全与 HTTP ──────────────────────────────────────────────
# CORS 白名单（逗号分隔完整 origin）；不配置则完全不开放跨域
# CORS_ORIGINS=https://web.example.com
# 会话 Cookie Secure 覆盖：production 默认 true；局域网 HTTP 部署必须显式 false
SESSION_COOKIE_SECURE=false
# 产品网页端静态托管目录（生产由 api 托管 support-web/dist；开发态走 Vite 可不配）
# WEB_DIST_DIR=../solutions/customer-support/apps/support-web/dist

# ── 业务行为设置命名空间（业务部署必填，纯平台模式可不配）────
# 绑定格式 <solutionId>/<extensionId>，指向设置中心里业务插件的行为键。
# 客服产品部署填 weflow.customer-support/support-pipeline。
# 不配置 = 纯平台模式：转人工提醒/群聊策略/分流/知识连接器界面分节全部回落引擎中立缺省。
# BEHAVIOR_SETTINGS_REF=weflow.customer-support/support-pipeline

# ── 由其他组件直接读取（不在 core config schema 内）──────────
# 业务插件目录直读加载；没有内置默认值——不设置 = 纯平台模式，不加载任何插件
# WEFLOW_PLUGIN_DIR=../solutions/customer-support
# 语音转码工具链（ingestion worker 的 ASR/转码链路读取）
# VOICE_FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# VOICE_PYTHON_PATH=C:/path/to/venv/Scripts/python.exe
