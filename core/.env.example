NODE_ENV=development
LOG_LEVEL=info
HEALTH_HOST=127.0.0.1
CORE_PORT=3100
AGENT_WORKER_HEALTH_PORT=3101
AGENT_WORKER_CONCURRENCY=3
MEMORY_CAPTURE_CONCURRENCY=1
INGESTION_WORKER_HEALTH_PORT=3102
DATABASE_URL=postgresql://weflow:weflow@127.0.0.1:5432/weflow
REDIS_URL=redis://127.0.0.1:6379
FILE_STORAGE_ROOT=.data/files
# Python Channel Host：只提供 durable inbound text observations
CHANNEL_HOST_BASE_URL=http://127.0.0.1:43123
CHANNEL_HOST_TOKEN_FILE=/run/secrets/channel_host_token
CHANNEL_HOST_POLL_INTERVAL_MS=1000
# 头像代理允许拉取的域名后缀白名单（逗号分隔；不配置 = 头像代理一律 404）
# AVATAR_ALLOWED_HOSTS=qlogo.cn,weixin.qq.com
# DeepSeek/OpenAI-compatible Model Runtime；密钥优先通过只读文件注入
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY_FILE=/run/secrets/model_api_key
MODEL_NAME=deepseek-v4-flash
MODEL_TIMEOUT_MS=60000
# MiMo/OpenAI-compatible Vision Runtime；开发凭证只通过临时环境或只读文件注入
VISION_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
VISION_API_KEY_FILE=/run/secrets/vision_api_key
VISION_MODEL=mimo-v2.5
VISION_TIMEOUT_MS=60000
# WeKnora 仅作为知识解析与检索服务；Core 不调用其 Agent、Chat 或 IM API。
# 默认自动发现该 API Key 可访问的知识库；如需收窄范围，可设置逗号分隔的 KB ID 白名单。
WEKNORA_BASE_URL=http://localhost/api/v1
WEKNORA_API_KEY_FILE=/run/secrets/weknora_api_key
WEKNORA_TIMEOUT_MS=15000
# WEKNORA_KNOWLEDGE_BASE_IDS=kb-a,kb-b
