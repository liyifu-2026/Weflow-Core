{
  "name": "@weflow/contracts",
  "version": "0.1.0",
  "description": "Stable public contracts for Weflow Platform: AgentAction, AgentExecutionStrategy, runtime/solution state, audit and error codes.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "npm run build:test && node dist-test/tests/agent.test.js"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "typescript": "5.9.3"
  }
}
