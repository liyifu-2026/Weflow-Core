{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ALLOW_INSECURE_HTTP": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ALLOW_INSECURE_HTTP": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  }
}
