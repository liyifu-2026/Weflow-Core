{
  "name": "@weflow/mobile",
  "version": "0.9.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "bash scripts/start-lan.sh",
    "android": "EXPO_PUBLIC_ALLOW_INSECURE_HTTP=true expo run:android",
    "ios": "EXPO_PUBLIC_ALLOW_INSECURE_HTTP=true expo run:ios",
    "web": "EXPO_PUBLIC_ALLOW_INSECURE_HTTP=true expo start --web",
    "android:verify": "node scripts/verify-android-identity.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.20",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-video": "~57.0.3",
    "phosphor-react-native": "^3.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
