{
  "apiVersion": "weflow.io/v1",
  "kind": "Solution",
  "metadata": {
    "id": "weflow.customer-support",
    "name": "Customer Support Solution",
    "version": "1.3.0",
    "publisher": "weflow"
  },
  "compatibility": {
    "platform": ">=1.0.0 <2.0.0",
    "pluginSdk": "^1.0.0"
  },
  "dependencies": {
    "capabilities": [
      "knowledge.retrieval"
    ],
    "solutions": []
  },
  "artifacts": [
    {
      "id": "customer-support-strategy",
      "kind": "plugin",
      "ref": "file:./plugins/customer-support-strategy",
      "targetProcess": "agent-worker"
    },
    {
      "id": "product-troubleshooting",
      "kind": "plugin",
      "ref": "file:./plugins/product-troubleshooting",
      "targetProcess": "agent-worker"
    },
    {
      "id": "support-web",
      "type": "app",
      "ref": "file:./apps/support-web"
    },
    {
      "id": "mobile",
      "type": "app",
      "ref": "file:./apps/mobile"
    },
    {
      "id": "operations-web",
      "type": "app",
      "ref": "file:./apps/operations-web"
    }
  ],
  "permissions": [
    {
      "id": "agent.strategy.register",
      "resource": "agent.strategy",
      "action": "write",
      "description": "Register the support execution strategy."
    },
    {
      "id": "agent.skill.register",
      "resource": "agent.skill",
      "action": "write",
      "description": "Register product troubleshooting behavior."
    },
    {
      "id": "channel.wechat.use",
      "resource": "channel.wechat",
      "action": "execute",
      "description": "Receive and send support messages through the configured channel."
    }
  ],
  "configuration": {
    "defaults": {
      "enabled": true,
      "autoSendEnabled": true,
      "handoff_notice": "已为您转接人工客服"
    }
  },
  "secretSlots": [
    {
      "name": "support_bff_api_key",
      "kind": "env",
      "required": false
    }
  ],
  "resources": [],
  "executionProfiles": [
    {
      "id": "customer-support-v1",
      "strategyRef": "weflow.customer-support/structured-v1",
      "maxModelCalls": 2,
      "maxToolCalls": 3,
      "timeoutSeconds": 60,
      "allowedTools": [
        "query_contact_profile",
        "retrieve_knowledge",
        "fetch_url"
      ],
      "skills": [
        {
          "id": "weflow.customer-support/product-troubleshooting",
          "version": "1.0.0"
        }
      ]
    }
  ],
  "applications": [
    {
      "id": "support-web",
      "type": "web",
      "entry": "apps/support-web"
    },
    {
      "id": "mobile",
      "type": "mobile",
      "entry": "apps/mobile"
    }
  ],
  "consoleExtensions": [
    {
      "id": "support-conversations",
      "title": "会话",
      "path": "/support/conversations",
      "entry": "apps/support-web/dist/support-console.js",
      "icon": "conversations",
      "group": "客服业务"
    },
    {
      "id": "support-knowledge",
      "title": "知识",
      "path": "/support/knowledge",
      "entry": "apps/support-web/dist/support-console.js",
      "icon": "knowledge",
      "group": "客服业务"
    },
    {
      "id": "support-admin",
      "title": "管理",
      "path": "/support/admin",
      "entry": "apps/support-web/dist/support-console.js",
      "icon": "settings",
      "group": "客服业务",
      "adminOnly": true
    },
    {
      "id": "support-whitelist",
      "title": "白名单配置",
      "path": "/support/whitelist",
      "entry": "apps/support-web/dist/support-console.js",
      "icon": "users",
      "group": "客服业务",
      "adminOnly": true,
      "hidden": true
    },
    {
      "id": "support-pipeline",
      "title": "接待编排",
      "path": "/support/pipeline",
      "entry": "apps/support-web/dist/support-console.js",
      "icon": "engine",
      "group": "客服业务",
      "adminOnly": true
    },
    {
      "id": "support-operations",
      "title": "运行",
      "path": "/support/operations",
      "entry": "apps/operations-web/dist/operations-console.js",
      "icon": "runtime",
      "group": "客服业务",
      "adminOnly": true
    }
  ],
  "healthChecks": [],
  "dashboardContributions": [
    {
      "id": "today-conversations",
      "title": "今日会话",
      "metric": "today_conversations",
      "unit": "个",
      "href": "/extensions/weflow.customer-support/support-conversations"
    },
    {
      "id": "pending-handoffs",
      "title": "待人工处理",
      "metric": "pending_handoffs",
      "unit": "个",
      "href": "/extensions/weflow.customer-support/support-conversations"
    },
    {
      "id": "knowledge-status",
      "title": "知识库",
      "metric": "active_solutions",
      "unit": "个方案",
      "href": "/extensions/weflow.customer-support/support-knowledge"
    }
  ]
}
