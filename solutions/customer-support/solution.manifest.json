{
  "apiVersion": "weflow.io/v1",
  "kind": "Solution",
  "metadata": {
    "id": "weflow.customer-support",
    "name": "Customer Support Solution",
    "version": "2.0.0",
    "publisher": "weflow"
  },
  "compatibility": {
    "platform": ">=1.0.0 <2.0.0",
    "pluginSdk": "^1.0.0"
  },
  "dependencies": {
    "capabilities": [
      "knowledge.retrieval"
    ],
    "solutions": []
  },
  "artifacts": [
    {
      "id": "customer-support-strategy",
      "kind": "plugin",
      "ref": "file:./plugins/customer-support-strategy",
      "targetProcess": "agent-worker"
    },
    {
      "id": "product-troubleshooting",
      "kind": "plugin",
      "ref": "file:./plugins/product-troubleshooting",
      "targetProcess": "agent-worker"
    },
    {
      "id": "support-web",
      "type": "app",
      "ref": "file:./apps/support-web"
    },
    {
      "id": "mobile",
      "type": "app",
      "ref": "file:./apps/mobile"
    }
  ],
  "permissions": [
    {
      "id": "agent.strategy.register",
      "resource": "agent.strategy",
      "action": "write",
      "description": "Register the support execution strategy."
    },
    {
      "id": "agent.skill.register",
      "resource": "agent.skill",
      "action": "write",
      "description": "Register product troubleshooting behavior."
    },
    {
      "id": "channel.wechat.use",
      "resource": "channel.wechat",
      "action": "execute",
      "description": "Receive and send support messages through the configured channel."
    }
  ],
  "configuration": {
    "defaults": {
      "enabled": true,
      "autoSendEnabled": true,
      "handoff_notice": "已为您转接人工客服"
    }
  },
  "secretSlots": [
    {
      "name": "support_bff_api_key",
      "kind": "env",
      "required": false
    }
  ],
  "resources": [],
  "executionProfiles": [
    {
      "id": "customer-support-v1",
      "strategyRef": "weflow.customer-support/structured-v1",
      "maxModelCalls": 2,
      "maxToolCalls": 3,
      "timeoutSeconds": 60,
      "allowedTools": [
        "query_contact_profile",
        "retrieve_knowledge",
        "fetch_url"
      ],
      "skills": [
        {
          "id": "weflow.customer-support/product-troubleshooting",
          "version": "1.0.0"
        }
      ]
    }
  ],
  "applications": [
    {
      "id": "support-web",
      "type": "web",
      "entry": "apps/support-web"
    },
    {
      "id": "mobile",
      "type": "mobile",
      "entry": "apps/mobile"
    }
  ],
  "healthChecks": []
}
