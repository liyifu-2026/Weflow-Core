{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weflow",
  "version": "2.0.0",
  "identifier": "com.weflow.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://updates.example.com/weflow-desktop/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
