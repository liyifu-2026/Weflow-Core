{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/main.ts",
    "src/App.vue",
    "src/router/**/*.ts",
    "src/weflow/**/*.ts",
    "src/weflow/**/*.vue"
  ],
  "exclude": ["src/**/__tests__/*", "src/**/*.test.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
