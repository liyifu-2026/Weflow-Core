{
  "name": "@weflow-leaif/plugin-sdk",
  "version": "1.0.0",
  "description": "Weflow Plugin SDK: runtime plugin manifest, capability tokens, lifecycle and Tool/Skill/Execution Strategy registration contracts.",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "npm run build:test && node dist-test/tests/plugin.test.js",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@weflow-leaif/contracts": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
