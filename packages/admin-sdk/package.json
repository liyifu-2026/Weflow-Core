{
  "name": "@weflow/admin-sdk",
  "version": "0.1.0",
  "description": "Weflow Admin SDK for Console, Solution Runner and ops tooling to call Core admin interfaces with runtime-validated responses.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "npm run build:test \u0026\u0026 node dist-test/tests/admin.test.js",
    "check": "pnpm typecheck \u0026\u0026 pnpm test"
  },
  "dependencies": {
    "@weflow/contracts": "link:../contracts"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
